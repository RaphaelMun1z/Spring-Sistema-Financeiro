# Copie para .env e substitua os campos vazios antes de executar o Compose.
POSTGRES_HOST=localhost
POSTGRES_USER=gestao_financeira
POSTGRES_DB=gestao_financeira
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
JWT_SECRET=
SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:4200

# Ative somente ao provisionar um usuário real. Senha entre 12 caracteres e 72 bytes.
INITIAL_USER_ENABLED=false
INITIAL_USER_NAME=
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

SPRING_PROFILES_ACTIVE=dev

DATA_MOCK_ENABLED=false